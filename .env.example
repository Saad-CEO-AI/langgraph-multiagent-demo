# Which provider get_llm() should use: "openai" (default), "anthropic", "groq", or "mock"
LLM_PROVIDER=openai

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Required if LLM_PROVIDER=groq -- free tier, get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
